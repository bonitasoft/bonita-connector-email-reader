<?xml version="1.0" encoding="UTF-8"?>
<definition:ConnectorDefinition xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:definition="http://www.bonitasoft.org/ns/connector/definition/6.1">
    <id>${emailreader-read-inbox.def.id}</id>
    <version>${emailreader-read-inbox.def.version}</version>
    <icon>email-reader.png</icon>
    <category id="Email Reader" icon="email-reader.png"/>

    <!-- Connection inputs (Project/Runtime scope) -->
    <input name="imapHost" type="java.lang.String" mandatory="true"/>
    <input name="imapPort" type="java.lang.Integer" mandatory="false" defaultValue="993"/>
    <input name="username" type="java.lang.String" mandatory="true"/>
    <input name="password" type="java.lang.String" mandatory="false"/>
    <input name="authMode" type="java.lang.String" mandatory="false" defaultValue="PASSWORD"/>
    <input name="oauth2AccessToken" type="java.lang.String" mandatory="false"/>
    <input name="useTls" type="java.lang.Boolean" mandatory="false" defaultValue="true"/>
    <input name="connectTimeout" type="java.lang.Integer" mandatory="false" defaultValue="30000"/>
    <input name="readTimeout" type="java.lang.Integer" mandatory="false" defaultValue="60000"/>

    <!-- Inbox configuration inputs (Process/Connector scope) -->
    <input name="folderName" type="java.lang.String" mandatory="false" defaultValue="INBOX"/>
    <input name="onlyUnread" type="java.lang.Boolean" mandatory="false" defaultValue="true"/>
    <input name="maxMessages" type="java.lang.Integer" mandatory="false" defaultValue="50"/>
    <input name="markAsReadAfterFetch" type="java.lang.Boolean" mandatory="false" defaultValue="false"/>

    <!-- Outputs -->
    <output name="emails" type="java.lang.String"/>
    <output name="emailCount" type="java.lang.Integer"/>
    <output name="hasMore" type="java.lang.Boolean"/>
    <output name="success" type="java.lang.Boolean"/>
    <output name="errorMessage" type="java.lang.String"/>

    <!-- UI Pages -->
    <page id="connectionPage">
        <widget xsi:type="definition:Text" id="imapHostWidget" inputName="imapHost"/>
        <widget xsi:type="definition:Text" id="imapPortWidget" inputName="imapPort"/>
        <widget xsi:type="definition:Text" id="usernameWidget" inputName="username"/>
        <widget xsi:type="definition:Password" id="passwordWidget" inputName="password"/>
        <widget xsi:type="definition:Select" id="authModeWidget" inputName="authMode">
            <items>PASSWORD</items>
            <items>OAUTH2</items>
        </widget>
        <widget xsi:type="definition:Password" id="oauth2AccessTokenWidget" inputName="oauth2AccessToken"/>
        <widget xsi:type="definition:Checkbox" id="useTlsWidget" inputName="useTls"/>
        <widget xsi:type="definition:Text" id="connectTimeoutWidget" inputName="connectTimeout"/>
        <widget xsi:type="definition:Text" id="readTimeoutWidget" inputName="readTimeout"/>
    </page>
    <page id="inboxConfigPage">
        <widget xsi:type="definition:Text" id="folderNameWidget" inputName="folderName"/>
        <widget xsi:type="definition:Checkbox" id="onlyUnreadWidget" inputName="onlyUnread"/>
        <widget xsi:type="definition:Text" id="maxMessagesWidget" inputName="maxMessages"/>
        <widget xsi:type="definition:Checkbox" id="markAsReadAfterFetchWidget" inputName="markAsReadAfterFetch"/>
    </page>
</definition:ConnectorDefinition>
